<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_other</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Type, &#39;Other&#39;) , ISBLANK( other__c ))</errorConditionFormula>
    <errorDisplayField>other__c</errorDisplayField>
    <errorMessage>If Type is Other than other field is mandatory</errorMessage>
</ValidationRule>
