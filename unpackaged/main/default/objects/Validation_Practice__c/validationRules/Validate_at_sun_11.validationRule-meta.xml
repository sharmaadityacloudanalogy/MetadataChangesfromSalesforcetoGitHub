<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_at_sun_11</fullName>
    <active>false</active>
    <errorConditionFormula>AND( WEEKDAY(  Weekdays__c  ) &lt;&gt; 1  , WEEKDAY(  Weekdays__c  )  &lt;&gt; 7 )</errorConditionFormula>
    <errorDisplayField>Weekdays__c</errorDisplayField>
    <errorMessage>The date must be a Saturday or Sunday.</errorMessage>
</ValidationRule>
