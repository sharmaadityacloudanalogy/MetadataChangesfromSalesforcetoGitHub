<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Percent_20</fullName>
    <active>false</active>
    <errorConditionFormula>OR( Discount__c &lt; 0.1, Discount__c &gt; 0.4)</errorConditionFormula>
    <errorMessage>Discount must be B/W 0% TO 40%</errorMessage>
</ValidationRule>
