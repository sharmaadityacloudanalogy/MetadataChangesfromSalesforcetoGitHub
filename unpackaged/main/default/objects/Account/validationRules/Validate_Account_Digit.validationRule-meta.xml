<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Account_Digit</fullName>
    <active>false</active>
    <errorConditionFormula>AND( LEN(AccountNumber)  &lt;&gt; 7 , NOT(ISNULL(AccountNumber)))</errorConditionFormula>
    <errorMessage>Account Number should be exactly seven digits and should not be blank.</errorMessage>
</ValidationRule>
