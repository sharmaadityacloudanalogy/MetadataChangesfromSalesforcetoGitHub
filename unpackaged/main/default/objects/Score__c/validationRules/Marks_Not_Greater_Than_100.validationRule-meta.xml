<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Marks_Not_Greater_Than_100</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(Marks__c &lt; 100)</errorConditionFormula>
    <errorDisplayField>Marks__c</errorDisplayField>
    <errorMessage>Marks Should be less than 100</errorMessage>
</ValidationRule>
