<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_Amount_21</fullName>
    <active>false</active>
    <errorConditionFormula>OR(Amount &lt; 0,Amount &gt; 100000000)</errorConditionFormula>
    <errorDisplayField>Amount</errorDisplayField>
    <errorMessage>Amount must be Positive and not more than $10 million</errorMessage>
</ValidationRule>
